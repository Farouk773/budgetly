// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  // manually declared total balance (all accounts/cash) until Open Banking (Phase 12)
  balanceCents Int?
  balanceAsOf  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  incomes      Income[]
  fixedCharges FixedCharge[]
  expenses     Expense[]
}

// Shared reference data (not user-scoped): the default category taxonomy,
// seeded once. Manual selection for now; Phase 8 adds AI auto-categorization.
model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  isEssential  Boolean       @default(true)
  fixedCharges FixedCharge[]
  expenses     Expense[]
}

model FixedCharge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  label       String
  amountCents Int
  dayOfMonth  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  label       String?
  amountCents Int
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

enum IncomeType {
  SALARY
  FREELANCE
  OTHER
}

model Income {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                IncomeType
  label               String?
  netAmountCents      Int
  grossAmountCents    Int?
  contributionsCents  Int?
  bonusCents          Int?
  overtimeCents       Int?
  periodMonth         DateTime
  payslipOriginalName String?
  // random-generated on-disk filename; never derived from user input, to rule out path traversal
  payslipStoredName   String?
  payslipMimeType     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  // sha256 of the raw cookie token; only the hash is persisted so a DB leak doesn't yield valid sessions
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
