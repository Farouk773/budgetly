// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  // display currency, chosen at signup — pure representation choice, no FX conversion (see CURRENCY_PLAN.md)
  currency     Currency      @default(EUR)
  // manually declared total balance (all accounts/cash) until Open Banking (Phase 12)
  balanceCents  Int?
  balanceAsOf   DateTime?
  balanceSource BalanceSource?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  incomes      Income[]
  fixedCharges FixedCharge[]
  expenses     Expense[]
  savingsGoals SavingsGoal[]
  loans        Loan[]
  loanPayments LoanPayment[]
  sentLinks     PartnerLink[] @relation("RequestedLinks")
  receivedLinks PartnerLink[] @relation("PartnerLinks")
}

enum BalanceSource {
  BANK
  CASH
  MIXED
}

enum Currency {
  EUR
  USD
  GBP
  CHF
  TND
  MAD
}

enum PartnerLinkStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A consented, bidirectional link for the "shared household view" (point 12
// of the spec). Deliberately additive: it never changes ownership on any
// existing Income/Expense/etc. row — each side's data stays private and
// isolated exactly as before; a link only grants a read-only, aggregated
// summary once BOTH users have accepted.
model PartnerLink {
  id          String            @id @default(cuid())
  requesterId String
  requester   User              @relation("RequestedLinks", fields: [requesterId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     User              @relation("PartnerLinks", fields: [partnerId], references: [id], onDelete: Cascade)
  status      PartnerLinkStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([requesterId, partnerId])
  @@index([partnerId])
}

model Loan {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  remainingCents      Int
  monthlyPaymentCents Int
  // annual interest rate in basis points (350 = 3.50%), for the early-repayment simulator
  annualRateBps       Int           @default(0)
  dueDayOfMonth       Int           @default(1)
  endDate             DateTime
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  payments            LoanPayment[]

  @@index([userId])
}

// One row per real, dated loan repayment, recorded when the user clicks
// "Payer" — this is what makes a loan payment affect the global balance the
// same way a dated Expense does, instead of Loan.monthlyPaymentCents being
// deducted automatically every month regardless of user action. Kept
// separate from the decrement already applied to Loan.remainingCents: that
// field still represents "principal left to pay off", this table represents
// "money that actually left the budget, and when".
model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model SavingsGoal {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetCents   Int
  currentCents  Int                  @default(0)
  targetDate    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  contributions SavingsContribution[]

  @@index([userId])
}

// One row per deposit, kept even though SavingsGoal.currentCents already has
// the running total — this is what lets us compute a real "N months in a
// row" streak instead of a fabricated one.
model SavingsContribution {
  id            String      @id @default(cuid())
  savingsGoalId String
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  userId        String
  amountCents   Int
  createdAt     DateTime    @default(now())

  @@index([userId])
}

// Shared reference data (not user-scoped): the default category taxonomy,
// seeded once. Manual selection for now; Phase 8 adds AI auto-categorization.
model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  isEssential  Boolean       @default(true)
  fixedCharges FixedCharge[]
  expenses     Expense[]
}

model FixedCharge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  label       String
  amountCents Int
  dayOfMonth  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  label       String?
  amountCents Int
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

enum IncomeType {
  SALARY
  FREELANCE
  OTHER
}

model Income {
  id                  String     @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                IncomeType
  label               String?
  netAmountCents      Int
  grossAmountCents    Int?
  contributionsCents  Int?
  bonusCents          Int?
  overtimeCents       Int?
  periodMonth         DateTime
  // When true, this income is counted every month from `periodMonth`
  // (inclusive) onward, not just for that one month — same "computed live,
  // no per-month row generated" model as FixedCharge.active. `periodMonth`
  // becomes the recurrence's start month in that case. Known limitation
  // (shared with FixedCharge): editing amount/periodMonth/isRecurring later
  // recomputes past months too, it does not preserve point-in-time history.
  isRecurring         Boolean    @default(false)
  payslipOriginalName String?
  // random-generated on-disk filename; never derived from user input, to rule out path traversal
  payslipStoredName   String?
  payslipMimeType     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  // sha256 of the raw cookie token; only the hash is persisted so a DB leak doesn't yield valid sessions
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum LoginAttemptAction {
  LOGIN
  SIGNUP
}

// Sliding-window rate limiting for /api/auth/login and /api/auth/signup.
// Backed by the DB (not process memory) because a Vercel serverless
// invocation is not guaranteed to reuse the same instance — see
// `backend/rate-limit.ts` for the actual window/threshold logic. Rows older
// than the window are purged opportunistically on every check, so this
// table never grows unbounded.
model LoginAttempt {
  id        String             @id @default(cuid())
  action    LoginAttemptAction
  email     String
  ip        String
  success   Boolean            @default(false)
  createdAt DateTime           @default(now())

  @@index([action, email, createdAt])
  @@index([action, ip, createdAt])
}
