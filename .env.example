# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5433/gestion_salaire?schema=public"

# API Claude (Anthropic) — extraction fiche de paie, chat IA, catégorisation
ANTHROPIC_API_KEY=""

# Authentification (sessions)
# Non utilisé aujourd'hui : le système de session actuel repose sur des
# tokens opaques (crypto.randomBytes) hashés en sha256 et vérifiés par lookup
# en base (backend/auth.ts), pas sur un secret de signature. Conservé en
# commentaire au cas où un futur besoin (ex. JWT signés) le rendrait utile.
# AUTH_SECRET=""

# URL publique de l'application (utile pour callbacks OAuth, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
